var CH=null;
function ticks(min,max,n){
  var span=max-min,raw=span/n,mag=Math.pow(10,Math.floor(Math.log10(raw))),f=raw/mag;
  var step=(f<1.5?1:f<3?2:f<7?5:10)*mag,t=[];
  for(var v=Math.ceil(min/step-1e-9)*step;v<=max+1e-9;v+=step)t.push(+v.toFixed(10));
  return t;
}
function tk(v){return String(+v.toPrecision(4))}
function chartSpec(){
  var vs=S.vs,i,xs=[],ys=[],sp;
  if(S.mode==='strain'){
    var k={quarter:.25,half:.5,full:1}[S.cfg],ex=[],id=[];
    var save=S.eps;
    for(i=-5000;i<=5000;i+=100){xs.push(i);S.eps=i;var s2=solve(arms(),vs,1e7);ex.push(s2.vbc*1e3);id.push(vs*S.gf*i*1e-6*k*1e3)}
