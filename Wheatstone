  $('xh').classList.remove('hidden');
  var l=$('xhl');l.setAttribute('x1',px);l.setAttribute('x2',px);
  var t=$('xht');t.textContent=tk(xs[n])+' → '+tk(y);
  t.setAttribute('x',clamp(px+8,CH.ml+4,CH.ml+CH.pw-110));t.setAttribute('y',CH.mt+14);
}

/* ---------- quiz ---------- */
var QZ=[
 {q:'What is the balance condition of the bridge in this lab (R₁ = A–B, R₂ = B–D, R₃ = A–C, R₄ = C–D)?',o:['R₁/R₂ = R₃/R₄','R₁/R₂ = R₄/R₃','R₁ + R₂ = R₃ + R₄','R₁R₂ = R₃R₄'],a:0,e:'Equal potentials at B and C require R₂/(R₁+R₂) = R₄/(R₃+R₄), which reduces to R₁R₄ = R₂R₃.'},
 {q:'At balance, what is the current through the galvanometer?',o:['Maximum','Zero','Equal to the supply current','Equal to Vs/Rg'],a:1,e:'Points B and C are at the same potential, so no current flows between them.'},
 {q:'Why is the bridge called a null-measurement method?',o:['It needs no power supply','The reading is taken when the detector shows zero, so meter calibration does not affect the result','It measures only zero resistance','It uses a zero-resistance galvanometer'],a:1,e:'The result depends on resistor ratios, not on the detector scale or on the supply voltage.'},
 {q:'Which change does NOT move the balance point?',o:['Changing R₃','Changing R₄','Changing the supply voltage Vs','Changing R₁'],a:2,e:'Vs scales both V_B and V_C equally, so the null stays where it is. It only changes the size of the deflection.'},
 {q:'A bridge has R₁ = 100 Ω, R₂ = 1000 Ω and balances at R₃ = 472 Ω. What is R₄ (= Rx)?',o:['47.2 Ω','472 Ω','4720 Ω','4.72 kΩ ÷ 10'],a:2,e:'Rx = R₃ · R₂/R₁ = 472 × 1000/100 = 4720 Ω.'},
 {q:'For best sensitivity of a bridge at balance, the four arms should be',o:['As different as possible','Of similar resistance','Zero ohms','Infinite'],a:1,e:'Sensitivity ΔVo ≈ Vs·(ΔR/R)/4 is greatest when the arms are of similar size and the detector is matched.'},
 {q:'What is the approximate output of a quarter-bridge strain gauge circuit?',o:['Vs·GF·ε','Vs·GF·ε / 2','Vs·GF·ε / 4','Vs·GF·ε / 8'],a:2,e:'With one active arm and small ΔR/R, Vo/Vs ≈ GF·ε/4.'},
 {q:'Two gauges in adjacent arms, one in tension and one in compression, form a',o:['Quarter bridge, output ¼ of full','Half bridge, output twice the quarter bridge and exactly linear','Full bridge','Kelvin bridge'],a:1,e:'The half bridge gives Vo = Vs·GF·ε/2, which is double the quarter bridge and has no first-order non-linearity.'},
 {q:'Which is a limitation of the simple Wheatstone bridge?',o:['It cannot use DC','Lead and contact resistance spoil measurements below about 1 Ω','It only works with a 10 V supply','It needs a variable galvanometer'],a:1,e:'For very low resistances, a Kelvin double bridge is used to remove lead and contact resistance.'}
];
var qa=[];
function renderQuiz(){
  qa=[];
  $('quiz').innerHTML=QZ.map(function(q,i){return '<div class="qz"><div><b>'+(i+1)+'.</b> '+q.q+'</div><div class="qo">'+q.o.map(function(o,j){return '<button class="opt" data-q="'+i+'" data-o="'+j+'">'+o+'</button>'}).join('')+'</div><div class="qe" id="qe'+i+'"></div></div>'}).join('');
  quizScore();
}
function quizScore(){
  var right=qa.filter(function(x){return x===true}).length,done=qa.filter(function(x){return x!==undefined}).length;
  $('score').textContent='Score: '+right+' / '+QZ.length+(done===QZ.length?(right===QZ.length?'  Perfect.':'  Quiz complete.'):'');
}

/* ---------- misc ---------- */
var tt=0;
function toast(m){var e=$('toast');e.textContent=m;e.classList.add('show');clearTimeout(tt);tt=setTimeout(function(){e.classList.remove('show')},2200)}
function toggleKey(){S.key=!S.key;$('keyTxt').textContent=S.key?'Closed':'Open';$('keyLed').className='led'+(S.key?' on':'');update()}

var MODES={
  explore:{t:'Explore the bridge',d:'Change any arm, the supply and the galvanometer. Watch the node potentials, branch currents and the needle respond, then find the null.'},
  measure:{t:'Measure an unknown resistor',d:'Balance the bridge with the R₃ decade box until the galvanometer reads zero. Then Rx = R₃ × R₂/R₁. Reveal the true value to check your error.'},
  strain:{t:'Strain-gauge bridge',d:'A deflection bridge turns a tiny resistance change into a voltage. Compare quarter, half and full bridge configurations.'}
};
function setMode(m){
  S.mode=m;
  document.querySelectorAll('.mode').forEach(function(b){b.setAttribute('aria-selected',b.dataset.mode===m)});
  $('modeTitle').textContent=MODES[m].t;$('modeDesc').textContent=MODES[m].d;
  var st=m==='strain';
  $('dialWrap').classList.toggle('hidden',st);$('dmm').classList.toggle('hidden',!st);
  $('galvCtl').classList.toggle('hidden',st);$('detNote').classList.toggle('hidden',!st);
  document.querySelectorAll('.proc').forEach(function(p){p.classList.toggle('on',p.id==='proc-'+m)});
  if(m==='measure'&&!S.rx)newRx();
  renderArms();update();
}
function resetExp(){
  S.vs=10;setPair('vs',10);S.key=true;$('keyTxt').textContent='Closed';$('keyLed').className='led on';
  S.rg=100;setPair('rg',100);S.range=1e-3;$('rangeSel').value='0.001';
  if(S.mode==='explore')S.R=[100,100,100,100];
  if(S.mode==='measure'){S.dec=[0,0,0,0,0];S.ratio=1;newRx();S.trials=S.trials.filter(function(t){return t.mode!=='measure'});renderTrials()}
  if(S.mode==='strain'){S.eps=0;S.gf=2;S.cfg='quarter';S.r0=350}
  renderArms();update();toast('Experiment reset');
}
function autoBalance(){
  var R=S.R,r4=R[2]*R[1]/R[0];
  if(r4>=1&&r4<=1000)R[3]=Math.round(r4*100)/100;
  else{var r3=R[3]*R[0]/R[1];if(r3>=1&&r3<=1000)R[2]=Math.round(r3*100)/100;else S.R=[100,100,100,100]}
  for(var i=0;i<4;i++)setPair('r'+i,S.R[i]);
  update();
}

function init(){
  buildDiagram();buildDial();renderQuiz();newRx();
  bindPair('vs',1,24,function(v){S.vs=v;update()});
  bindPair('rg',10,1000,function(v){S.rg=v;update()});
  $('rangeSel').addEventListener('change',function(e){S.range=+e.target.value;update()});
  $('keyBtn').addEventListener('click',toggleKey);
  $('resetBtn').addEventListener('click',resetExp);
  $('recBtn').addEventListener('click',record);
  $('csvBtn').addEventListener('click',copyCSV);
  $('clrBtn').addEventListener('click',function(){S.trials=[];renderTrials();$('csvBox').classList.add('hidden')});
  $('swSel').addEventListener('change',function(e){S.sweep=+e.target.value;renderChart()});
  $('yqSel').addEventListener('change',function(e){S.yq=e.target.value;renderChart()});
  $('chart').addEventListener('pointermove',chartHover);
  $('chart').addEventListener('pointerleave',function(){var x=$('xh');if(x)x.classList.add('hidden')});
  $('quizReset').addEventListener('click',renderQuiz);
  document.querySelectorAll('.mode').forEach(function(b){b.addEventListener('click',function(){setMode(b.dataset.mode)})});
  document.querySelectorAll('.tab').forEach(function(b){b.addEventListener('click',function(){
    S.tab=b.dataset.tab;
    document.querySelectorAll('.tab').forEach(function(x){x.setAttribute('aria-selected',x===b)});
    ['live','chart','obs','theory','proc','viva'].forEach(function(k){$('tab-'+k).classList.toggle('hidden',k!==S.tab)});
    if(S.tab==='chart')renderChart();
    if(S.tab==='obs')renderTrials();
  })});
  $('quiz').addEventListener('click',function(e){
    var b=e.target.closest('.opt');if(!b||b.disabled)return;
    var qi=+b.dataset.q,oi=+b.dataset.o,q=QZ[qi],ok=oi===q.a;
    qa[qi]=ok;
    b.parentNode.querySelectorAll('.opt').forEach(function(x,j){x.disabled=true;if(j===q.a)x.classList.add('right');else if(x===b)x.classList.add('wrong')});
    $('qe'+qi).textContent=(ok?'Correct. ':'Not quite. ')+q.e;
    quizScore();
  });
  $('armCtl').addEventListener('click',function(e){
    var b=e.target.closest('[data-act]');if(!b)return;
    var a=b.dataset.act;
    if(a==='auto')autoBalance();
    else if(a==='ratio'){S.ratio=+b.dataset.i;renderArms();update()}
    else if(a==='dec'){var k=+b.dataset.d;S.dec[k]=(S.dec[k]+(+b.dataset.dir)+10)%10;update()}
    else if(a==='rec')record();
    else if(a==='newrx'){newRx();S.trials=S.trials.filter(function(t){return t.mode!=='measure'});renderTrials();update();toast('New unknown resistor installed')}
    else if(a==='reveal'){S.revealed=true;renderTrials();update()}
    else if(a==='cfg'){S.cfg=b.dataset.c;renderArms();update()}
    else if(a==='tare'){S.eps=0;setPair('eps',0);update()}
  });
  $('armCtl').addEventListener('wheel',function(e){
    var dc=e.target.closest('.dc');if(!dc)return;
    e.preventDefault();var k=+dc.dataset.d;S.dec[k]=(S.dec[k]+(e.deltaY<0?1:-1)+10)%10;update();
  },{passive:false});
  var app=$('wbApp');
  $('themeBtn').addEventListener('click',function(){
    var next=app.getAttribute('data-theme')==='dark'?'light':'dark';app.setAttribute('data-theme',next);
    try{localStorage.setItem('wb-theme',next)}catch(e){}
  });
  try{var th=localStorage.getItem('wb-theme');if(th==='dark'||th==='light')app.setAttribute('data-theme',th)}catch(e){}
  function sz(){var w=app.getBoundingClientRect().width;app.setAttribute('data-w',w>=1400?'lg':w>=760?'md':'sm')}
  sz();
  if(window.ResizeObserver)new ResizeObserver(sz).observe(app);else window.addEventListener('resize',sz);
  setMode('explore');renderTrials();
}
init();
})();
</script>
</body>
