  s+='<text class="small" x="88" y="212">+</text><text class="small" x="88" y="242">−</text>';
  s+='<circle class="node" cx="160" cy="432" r="5"/><circle class="node" cx="230" cy="432" r="5"/>';
  s+='<line id="keyBlade" class="wire" x1="160" y1="432" x2="230" y2="432"/>';
  s+='<rect id="keyHit" class="keyhit" x="145" y="392" width="100" height="56"><title>Click to open or close key K</title></rect>';
