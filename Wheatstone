  s+='<text id="vsTxt" class="nv" x="62" y="462">Vs</text>';
  for(var i=0;i<4;i++){
    var a=P[EDGES[i][0]],b=P[EDGES[i][1]],mx=(a[0]+b[0])/2,my=(a[1]+b[1])/2;
    var ang=Math.atan2(b[1]-a[1],b[0]-a[0])*180/Math.PI;
    var nx=mx-320,ny=my-230,L=Math.hypot(nx,ny),ox=mx+nx/L*52,oy=my+ny/L*46;
    s+='<line class="wire" x1="'+a[0]+'" y1="'+a[1]+'" x2="'+b[0]+'" y2="'+b[1]+'"/>';
    s+='<line id="fl'+(i+1)+'" class="flow" x1="'+a[0]+'" y1="'+a[1]+'" x2="'+b[0]+'" y2="'+b[1]+'"/>';
    s+='<g transform="translate('+mx+' '+my+') rotate('+ang+')"><rect id="rect'+(i+1)+'" class="res" x="-40" y="-13" width="80" height="26" rx="5"/></g>';
    s+='<text id="lab'+(i+1)+'" class="lbl" x="'+ox+'" y="'+oy+'" text-anchor="middle"></text>';
    s+='<text id="val'+(i+1)+'" class="val" x="'+ox+'" y="'+(oy+16)+'" text-anchor="middle"></text>';
    s+='<text id="tag'+(i+1)+'" class="tag" x="'+ox+'" y="'+(oy+31)+'" text-anchor="middle"></text>';
  }
  s+='<path class="wire" d="M150 230 H490"/><path id="flG" class="flow" d="M150 230 H490"/>';
  s+='<circle id="gC" class="gcirc" cx="320" cy="230" r="36"/><text id="gLab" class="lbl" x="320" y="238" text-anchor="middle" style="font-size:24px">G</text>';
  s+='<text id="gTxt" class="val" x="320" y="286" text-anchor="middle"></text>';
  ['A','B','C','D'].forEach(function(k){s+='<circle class="node" cx="'+P[k][0]+'" cy="'+P[k][1]+'" r="7"/>'});
  s+='<text x="334" y="56"><tspan class="lbl">A</tspan><tspan id="nA" class="nv" dx="8"></tspan></text>';
  s+='<text x="150" y="254" text-anchor="middle"><tspan class="lbl">B</tspan><tspan id="nB" class="nv" dx="8"></tspan></text>';
  s+='<text x="490" y="254" text-anchor="middle"><tspan class="lbl">C</tspan><tspan id="nC" class="nv" dx="8"></tspan></text>';
  s+='<text x="334" y="416"><tspan class="lbl">D</tspan><tspan id="nD" class="nv" dx="8"></tspan></text>';
  $('diagram').innerHTML=s;
  $('keyHit').addEventListener('click',toggleKey);
}
var GAUGE_TAGS={quarter:{2:'▲ gauge (+ε)'},half:{2:'▲ gauge (+ε)',3:'▼ gauge (−ε)'},
  full:{0:'▼ gauge (−ε)',1:'▲ gauge (+ε)',2:'▲ gauge (+ε)',3:'▼ gauge (−ε)'}};
function setFlow(id,i,on){
  var el=$(id),a=Math.abs(i);
  if(!on||a<5e-7){el.style.opacity=0;return}
  el.style.opacity=1;
  el.style.animationDuration=clamp(1.3-0.32*Math.log10(a/0.01),0.35,3.5)+'s';
  el.style.animationDirection=i>=0?'normal':'reverse';
}
function updDiagram(R,sol,bal){
  var names=S.mode==='measure'?['R₁ (P)','R₂ (Q)','R₃ (decade)','R₄ = Rx']:SUBN;
  var hide=S.mode==='measure'&&!S.revealed;
  for(var i=0;i<4;i++){
    $('lab'+(i+1)).textContent=names[i];
    $('val'+(i+1)).textContent=(hide&&i===3)?'? Ω':fmtR(R[i]);
    var tg=S.mode==='strain'&&GAUGE_TAGS[S.cfg][i];
    $('tag'+(i+1)).textContent=tg||'';
    $('rect'+(i+1)).setAttribute('class','res'+(tg?' gauge':''));
    setFlow('fl'+(i+1),sol.i[i],S.key);
  }
  setFlow('flG',sol.ig,S.key&&!bal);
  setFlow('flS1',sol.it,S.key);setFlow('flS2',sol.it,S.key);
  $('nA').textContent=fmtV(sol.vs);$('nB').textContent=fmtV(sol.vb);$('nC').textContent=fmtV(sol.vc);$('nD').textContent='0 V';
