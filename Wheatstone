<script>
(function(){
'use strict';
var $=function(id){return document.getElementById(id)};
var clamp=function(v,a,b){return Math.min(b,Math.max(a,v))};

/* ---------- state ---------- */
var S={mode:'explore',vs:10,R:[100,100,100,100],rg:100,range:1e-3,key:true,
  ratio:1,dec:[0,0,0,0,0],rx:100,revealed:false,hint:true,
  r0:350,gf:2,eps:0,cfg:'quarter',trials:[],tab:'live',sweep:3,yq:'vo'};
var RATIOS=[{p:1000,q:100,t:'×0.1'},{p:100,q:100,t:'×1'},{p:100,q:1000,t:'×10'}];
var SUBN=['R₁','R₂','R₃','R₄'];

function newRx(){S.rx=Math.round(Math.pow(10,1.3+Math.random()*1.65));S.revealed=false}
function decVal(){var d=S.dec;return d[0]*1000+d[1]*100+d[2]*10+d[3]+d[4]/10}
function setDec(v){var t=Math.round(clamp(v,0,9999.9)*10);
  S.dec=[Math.floor(t/10000),Math.floor(t/1000)%10,Math.floor(t/100)%10,Math.floor(t/10)%10,t%10]}

function arms(){
  if(S.mode==='explore')return S.R.slice();
  if(S.mode==='measure'){var r=RATIOS[S.ratio];return [r.p,r.q,decVal(),S.rx]}
  var x=clamp(S.gf*S.eps*1e-6,-0.95,0.95),r0=S.r0,a=[r0,r0,r0,r0];
  a[2]=r0*(1+x);
  if(S.cfg!=='quarter')a[3]=r0*(1-x);
  if(S.cfg==='full'){a[1]=r0*(1+x);a[0]=r0*(1-x)}
  return a;
}
function rgNow(){return S.mode==='strain'?1e7:S.rg}

/* ---------- circuit solver (nodal analysis) ---------- */
function solve(R,vs,rg){
  var g=R.map(function(r){return 1/Math.max(r,1e-3)}),gg=1/Math.max(rg,1e-3);
  var a=g[0]+g[1]+gg,d=g[2]+g[3]+gg,det=a*d-gg*gg,b1=vs*g[0],b2=vs*g[2];
  var vb=(b1*d+gg*b2)/det,vc=(a*b2+gg*b1)/det;
  var i1=(vs-vb)*g[0],i2=vb*g[1],i3=(vs-vc)*g[2],i4=vc*g[3],ig=(vb-vc)*gg;
  return {vs:vs,vb:vb,vc:vc,vbc:vb-vc,i:[i1,i2,i3,i4],ig:ig,it:i1+i3,
    v:[vs-vb,vb,vs-vc,vc],R:R};
}

/* ---------- formatting ---------- */
function fmtI(a){var x=Math.abs(a);if(x<1e-9)return '0.00 µA';if(x>=1)return a.toFixed(3)+' A';if(x>=1e-3)return (a*1e3).toFixed(3)+' mA';return (a*1e6).toFixed(2)+' µA'}
function fmtV(v){var x=Math.abs(v);if(x===0)return '0 V';if(x>=1)return v.toFixed(3)+' V';return (v*1e3).toFixed(2)+' mV'}
function fmtR(r){return (Math.round(r*100)/100).toLocaleString('en-US',{maximumFractionDigits:2})+' Ω'}
function fmtP(p){return p>=1?p.toFixed(2)+' W':(p*1e3).toFixed(2)+' mW'}
function sgn(v,d){return (v>0?'+':'')+v.toFixed(d)}

/* ---------- diagram ---------- */
var P={A:[320,60],B:[150,230],C:[490,230],D:[320,400]};
var EDGES=[['A','B'],['B','D'],['A','C'],['C','D']];
function buildDiagram(){
