<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Wheatstone Bridge Virtual Laboratory</title>
<style>
.wb-app{
  
  
  
  --bg:#e8eef2;--surface:#ffffff;--surface2:#f1f5f8;--ink:#12212e;--muted:#58708a;--line:#d3dfe8;
  --accent:#0d6e92;--accent-ink:#ffffff;--good:#10773a;--goodbg:#e4f5ea;--bad:#b3261e;--badbg:#fdeceb;
  --warn:#86540a;--warnbg:#fff4d9;--idle:#4a5d70;--idlebg:#e9eff4;
  --wire:#2b4157;--flow:#e08a00;--needle:#d92d20;--gaugebg:#d8eef7;--dial:#fbfdff;--shadow:0 5px 22px rgba(18,33,46,.09);
}
.wb-app[data-theme="dark"]{
  --bg:#0a131a;--surface:#121f2a;--surface2:#192a38;--ink:#e5eef5;--muted:#8da6bb;--line:#26394a;
  --accent:#4fb4d8;--accent-ink:#04141c;--good:#52d68f;--goodbg:#0f2f20;--bad:#ff8c82;--badbg:#391613;
  --warn:#f4c35e;--warnbg:#33290f;--idle:#9db3c6;--idlebg:#1a2a38;
  --wire:#9db8cf;--flow:#ffb937;--needle:#ff6a5e;--gaugebg:#17384b;--dial:#0e1923;--shadow:0 5px 22px rgba(0,0,0,.45);
}
.wb-app *{box-sizing:border-box}
.wb-app{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 "Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif}
.wb-app button,.wb-app select,.wb-app input{font:inherit;color:inherit}
.wb-app :focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.wb-app .mono{font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;font-variant-numeric:tabular-nums}
.wb-app .top{background:linear-gradient(120deg,#082f4a,#0d6e92);color:#fff;padding:10px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.wb-app .brand{display:flex;gap:12px;align-items:center;min-width:0}
.wb-app .logo{flex:none;width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.14);display:grid;place-items:center}
.wb-app .logo svg{width:24px;height:24px}
.wb-app .top h1{margin:0;font-size:18px;line-height:1.2}
.wb-app .top p{margin:0;font-size:12px;opacity:.85}
.wb-app .icon{flex:none;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.12);color:#fff;border-radius:10px;padding:6px 11px;cursor:pointer}
.wb-app .modes{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;width:100%;max-width:1680px;margin:10px auto 0;padding:0 14px}
.wb-app .mode{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:8px 12px;cursor:pointer;text-align:left;font-weight:700;line-height:1.3}
.wb-app .mode small{display:none}
.wb-app .mode[aria-selected="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.wb-app main{width:100%;max-width:1680px;margin:10px auto 24px;padding:0 14px}
.wb-app .layout{display:grid;grid-template-columns:300px minmax(0,1fr);gap:12px;align-items:start}
.wb-app .stack{display:grid;gap:12px;min-width:0}
.wb-app .card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px;box-shadow:var(--shadow)}
.wb-app aside.card{position:sticky;top:8px;max-height:calc(100dvh - 16px);overflow:auto}
.wb-app h2{margin:0 0 2px;font-size:17px}
.wb-app h3{margin:14px 0 6px;font-size:15px}
.wb-app .muted{color:var(--muted);font-size:13px}
.wb-app .sec{border-top:1px solid var(--line);margin-top:10px;padding-top:10px}
.wb-app .sec:first-of-type{border-top:0;margin-top:6px;padding-top:0}
.wb-app .sec h3{margin:0 0 6px;font-size:13.5px;color:var(--muted);font-weight:700}
.wb-app .ctl{margin:7px 0}
.wb-app .ctlh{display:flex;justify-content:space-between;align-items:center;gap:8px;font-weight:700;font-size:14px}
.wb-app .inp{display:inline-flex;align-items:center;gap:4px}
.wb-app .inp em{font-style:normal;color:var(--muted);font-weight:600;font-size:13px}
.wb-app input[type=number],.wb-app select{background:var(--surface2);border:1px solid var(--line);border-radius:8px;padding:4px 7px;font-weight:700}
.wb-app input[type=number]{width:84px;text-align:right}
.wb-app select{max-width:100%}
.wb-app input[type=range]{width:100%;accent-color:var(--accent);margin:3px 0 0}
.wb-app .btns{display:flex;gap:8px;flex-wrap:wrap;margin-top:9px}
.wb-app .btn{border:1px solid var(--line);background:var(--surface2);border-radius:10px;padding:8px 12px;font-weight:700;cursor:pointer}
.wb-app .btn:hover{border-color:var(--accent)}
.wb-app .btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);flex:1}
.wb-app .btn[disabled]{opacity:.5;cursor:not-allowed}
.wb-app .seg{display:flex;gap:6px;flex-wrap:wrap}
.wb-app .seg .btn{flex:1;padding:7px 6px;text-align:center}
.wb-app .seg .btn.on{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.wb-app .check{display:flex;gap:8px;align-items:center;font-weight:600;font-size:14px;margin:8px 0 2px}
.wb-app .keybtn{width:100%;display:flex;align-items:center;justify-content:space-between}
.wb-app .led{width:12px;height:12px;border-radius:50%;background:var(--bad);box-shadow:0 0 0 3px var(--surface2)}
.wb-app .led.on{background:var(--good)}
.wb-app .hidden{display:none !important}
.wb-app .stage{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(210px,1fr);gap:12px;margin-top:8px}
.wb-app .panel{background:var(--surface2);border:1px solid var(--line);border-radius:14px;padding:6px;min-width:0}
.wb-app .panel svg{display:block;width:100%;height:auto}
.wb-app .formula{font-size:13.5px;background:var(--surface2);border:1px dashed var(--line);border-radius:10px;padding:7px 10px;margin:8px 0 0}
.wb-app .wire{stroke:var(--wire);stroke-width:4;fill:none;stroke-linecap:round;stroke-linejoin:round}
.wb-app .flow{stroke:var(--flow);stroke-width:4.6;fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:.1 15;animation:dash 1.2s linear infinite;opacity:0;transition:opacity .25s}
@keyframes dash{to{stroke-dashoffset:-15.1}}
@media (prefers-reduced-motion:reduce){.wb-app .flow{animation:none;stroke-dasharray:3 10}}
.wb-app .res{fill:var(--surface);stroke:var(--wire);stroke-width:3}
.wb-app .res.gauge{fill:var(--gaugebg);stroke:var(--accent)}
.wb-app .lbl{font-weight:800;fill:var(--ink);font-size:16px}
.wb-app .val{fill:var(--muted);font-size:12.5px;font-family:ui-monospace,Menlo,Consolas,monospace}
.wb-app .nv{fill:var(--accent);font-size:12.5px;font-weight:700;font-family:ui-monospace,Menlo,Consolas,monospace}
.wb-app .tag{font-size:11px;fill:var(--accent);font-weight:700}
.wb-app .node{fill:var(--accent)}
.wb-app .gcirc{fill:var(--surface);stroke:var(--accent);stroke-width:4;transition:stroke .2s}
.wb-app .gcirc.ok{stroke:var(--good)}
.wb-app .plate{stroke:var(--wire);stroke-linecap:round}
.wb-app .small{font-size:11.5px;fill:var(--muted)}
.wb-app .keyhit{cursor:pointer;fill:transparent}
.wb-app .face{fill:var(--dial);stroke:var(--line);stroke-width:2}
.wb-app .arc{fill:none;stroke:var(--wire);stroke-width:2}
.wb-app .tmin{stroke:var(--wire);stroke-width:1.2}
.wb-app .tmaj{stroke:var(--wire);stroke-width:2.2}
.wb-app .dl{font-size:9.5px;fill:var(--muted);font-family:ui-monospace,Menlo,Consolas,monospace}
.wb-app .needle{stroke:var(--needle);stroke-width:2.8;stroke-linecap:round}
.wb-app .hub{fill:var(--wire)}
.wb-app .ovl{fill:var(--line)}
.wb-app .ovl.on{fill:var(--bad)}
.wb-app .dig{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:4px 6px 0;flex-wrap:wrap}
.wb-app .dig b{font-size:18px}
.wb-app .dmm{background:var(--dial);border:1px solid var(--line);border-radius:12px;padding:12px;text-align:center}
.wb-app .dmm .big{font-size:30px;font-weight:700;margin:4px 0;color:var(--accent)}
.wb-app .reads{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px}
.wb-app .read{background:var(--surface2);border:1px solid var(--line);border-radius:11px;padding:8px 10px;min-width:0}
.wb-app .read small{display:block;color:var(--muted);font-size:12px}
.wb-app .read b{display:block;font-size:15.5px;margin-top:1px;overflow-wrap:anywhere}
.wb-app .read i{display:block;font-style:normal;font-size:11.5px;color:var(--muted)}
.wb-app .status{margin-top:10px;padding:9px 12px;border-radius:11px;font-weight:600}
.wb-app .status.ok{background:var(--goodbg);color:var(--good)}
.wb-app .status.bad{background:var(--badbg);color:var(--bad)}
.wb-app .status.warn{background:var(--warnbg);color:var(--warn)}
.wb-app .status.idle{background:var(--idlebg);color:var(--idle)}
.wb-app .status span{display:block;font-weight:500;font-size:13px;margin-top:2px;opacity:.95}
.wb-app table{width:100%;border-collapse:collapse;font-size:13.5px}
.wb-app th,.wb-app td{padding:6px 8px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}
.wb-app th:first-child,.wb-app td:first-child,.wb-app th.l,.wb-app td.l{text-align:left}
.wb-app th{color:var(--muted);font-weight:700;font-size:12.5px;background:var(--surface2)}
.wb-app tr.hot td{color:var(--bad);font-weight:700}
.wb-app .scroll{overflow-x:auto;border:1px solid var(--line);border-radius:10px}
.wb-app .warnline{margin-top:8px;font-size:13px;color:var(--warn);background:var(--warnbg);border-radius:8px;padding:7px 10px}
.wb-app .tabs{display:flex;gap:2px;border-bottom:1px solid var(--line);margin:-4px -4px 12px;overflow-x:auto;flex:none}
.wb-app .tab{border:0;background:none;padding:8px 12px;font-weight:700;color:var(--muted);cursor:pointer;border-bottom:3px solid transparent;white-space:nowrap}
.wb-app .tab[aria-selected="true"]{color:var(--accent);border-bottom-color:var(--accent)}
.wb-app .chartbar{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:8px}
.wb-app .chartbar label{font-size:13px;font-weight:700;color:var(--muted)}
.wb-app #chart{width:100%;height:auto;background:var(--surface2);border:1px solid var(--line);border-radius:12px;touch-action:pan-y}
.wb-app .ax{stroke:var(--muted);stroke-width:1.4}
.wb-app .gl{stroke:var(--line);stroke-width:1}
.wb-app .zero{stroke:var(--muted);stroke-width:1.4;stroke-dasharray:5 4}
.wb-app .tk{font-size:11px;fill:var(--muted);font-family:ui-monospace,Menlo,Consolas,monospace}
.wb-app .axt{font-size:12px;fill:var(--ink);font-weight:700}
.wb-app .cv{fill:none;stroke:var(--accent);stroke-width:3;stroke-linejoin:round}
.wb-app .cv2{fill:none;stroke:var(--flow);stroke-width:2.4;stroke-dasharray:7 5}
.wb-app .cmsg{fill:var(--muted);font-size:14px}
.wb-app .mk{fill:var(--needle);stroke:var(--surface);stroke-width:2}
.wb-app .nl{fill:var(--good);stroke:var(--surface);stroke-width:2}
.wb-app .mkt{font-size:12px;fill:var(--ink);font-weight:700}
.wb-app .cross{stroke:var(--muted);stroke-width:1;stroke-dasharray:3 3}
.wb-app .legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12.5px;color:var(--muted);margin-top:8px}
.wb-app .legend i{display:inline-block;width:22px;height:0;border-top:3px solid var(--accent);vertical-align:middle;margin-right:5px}
.wb-app .legend i.d{border-top:3px dashed var(--flow)}
.wb-app .eq{background:var(--surface2);border-left:4px solid var(--accent);border-radius:6px;padding:8px 12px;margin:8px 0;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13.5px;overflow-x:auto;white-space:nowrap}
.wb-app .doc p,.wb-app .doc li{max-width:78ch}
.wb-app .doc ul,.wb-app .doc ol{padding-left:22px}
.wb-app .proc{display:none}
.wb-app .proc.on{display:block}
.wb-app .qz{border:1px solid var(--line);border-radius:12px;padding:10px;margin:8px 0;background:var(--surface2)}
.wb-app .qo{display:grid;gap:6px;margin-top:8px}
.wb-app .opt{text-align:left;border:1px solid var(--line);background:var(--surface);border-radius:9px;padding:7px 11px;cursor:pointer}
.wb-app .opt:hover:not([disabled]){border-color:var(--accent)}
.wb-app .opt.right{background:var(--goodbg);border-color:var(--good);color:var(--good);font-weight:700}
.wb-app .opt.wrong{background:var(--badbg);border-color:var(--bad);color:var(--bad)}
.wb-app .qe{font-size:13px;color:var(--muted);margin-top:8px}
.wb-app .score{font-weight:800;font-size:16px}
.wb-app .toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translate(-50%,30px);background:var(--ink);color:var(--surface);padding:10px 16px;border-radius:10px;font-weight:600;opacity:0;pointer-events:none;transition:.25s;z-index:9;max-width:90vw}
.wb-app .toast.show{opacity:1;transform:translate(-50%,0)}
.wb-app .dec{display:flex;gap:5px;justify-content:center;align-items:flex-end;margin:4px 0 8px}
.wb-app .dc{display:flex;flex-direction:column;align-items:center;gap:3px}
.wb-app .dc small{color:var(--muted);font-weight:700;font-size:11.5px}
.wb-app .dc button{width:40px;height:24px;border:1px solid var(--line);background:var(--surface2);border-radius:7px;cursor:pointer;font-size:12px;padding:0}
.wb-app .dc button:hover{border-color:var(--accent)}
.wb-app .dg{width:40px;text-align:center;font-size:24px;font-weight:700;background:var(--dial);border:1px solid var(--line);border-radius:8px;padding:2px 0}
.wb-app .dp{font-size:26px;font-weight:800;padding-bottom:28px;color:var(--muted)}
.wb-app textarea{width:100%;min-height:120px;background:var(--surface2);border:1px solid var(--line);border-radius:8px;padding:8px;font:12.5px ui-monospace,Menlo,Consolas,monospace;color:var(--ink)}

.wb{display:block;width:100%}
.wb-app{text-align:left;text-transform:none;letter-spacing:normal;font-style:normal}
.wb-app h1,.wb-app h2,.wb-app h3{font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif !important;text-transform:none !important;letter-spacing:normal !important;font-style:normal !important}
.wb-app h1{font-size:18px !important;font-weight:700 !important;line-height:1.2 !important;margin:0 !important;color:#fff !important;padding:0 !important}
.wb-app h2{font-size:17px !important;font-weight:700 !important;line-height:1.3 !important;margin:0 0 2px !important;padding:0 !important;color:var(--ink) !important}
.wb-app h3{font-size:15px !important;font-weight:700 !important;line-height:1.3 !important;padding:0 !important;color:var(--ink) !important}
.wb-app .sec h3{font-size:13.5px !important;color:var(--muted) !important;margin:0 0 6px !important}
.wb-app .doc h3{margin:14px 0 6px !important}
.wb-app .doc h3:first-child{margin-top:0 !important}
.wb-app p,.wb-app li,.wb-app td,.wb-app th,.wb-app label,.wb-app small{font-family:inherit;letter-spacing:normal;text-transform:none}
.wb-app button,.wb-app select,.wb-app input,.wb-app textarea{font-family:inherit;letter-spacing:normal;text-transform:none;margin:0}
.wb-app .mono,.wb-app .eq{font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace !important}
.wb-app .eq{white-space:normal;overflow:visible;overflow-wrap:anywhere;font-size:12.5px}
.wb-app .tabs{display:grid;grid-template-columns:repeat(auto-fit,minmax(64px,1fr));gap:2px;overflow:visible;margin:-4px -4px 12px}
.wb-app .tab{padding:8px 4px;text-align:center}
.wb-app .lbl{font-size:18px}
.wb-app .val,.wb-app .nv{font-size:14.5px}
.wb-app .tag{font-size:12.5px}
.wb-app .tp{scrollbar-width:thin}

/* size modes set by script from the width actually available */
.wb-app[data-w="md"] .stage,.wb-app[data-w="lg"] .stage{grid-template-columns:minmax(0,1.5fr) minmax(190px,1fr)}
.wb-app:not([data-w="lg"]) .tp{max-height:400px;overflow:auto}
.wb-app[data-w="sm"] .layout{grid-template-columns:1fr}
.wb-app[data-w="sm"] aside.card{position:static;max-height:none}
.wb-app[data-w="sm"] .stage{grid-template-columns:1fr}
.wb-app[data-w="sm"] .modes{grid-template-columns:1fr}
.wb-app[data-w="sm"] .top p{display:none}
.wb-app[data-w="sm"] .top h1{font-size:16px !important}
.wb-app[data-w="lg"]{height:clamp(640px,calc(100vh - 24px),900px);display:flex;flex-direction:column}
.wb-app[data-w="lg"] .top,.wb-app[data-w="lg"] .modes{flex:none}
.wb-app[data-w="lg"] main{flex:1;min-height:0;margin:10px auto 12px}
.wb-app[data-w="lg"] .layout{height:100%;grid-template-columns:280px minmax(0,1fr);align-items:stretch}
.wb-app[data-w="lg"] aside.card{position:static;max-height:none;height:100%;overflow:auto}
.wb-app[data-w="lg"] .stack{grid-template-columns:minmax(0,1fr) 440px;height:100%;min-height:0;align-items:stretch}
.wb-app[data-w="lg"] .stack>.card{min-height:0;overflow:auto}
.wb-app[data-w="lg"] .tabcard{display:flex;flex-direction:column;overflow:hidden}
.wb-app[data-w="lg"] .tabcard .tp{flex:1;min-height:0;max-height:none;overflow:auto}
</style>
</head>
<body>
<div class="wb"><div class="wb-app" id="wbApp" data-w="md">

<header class="top">
  <div class="brand">
    <div class="logo" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#fff" stroke-width="2.2" stroke-linejoin="round"><path d="M14 3 L25 14 L14 25 L3 14 Z"/><path d="M3 14 H25" stroke-dasharray="2 3"/></svg>
    </div>
    <div>
      <h1>Wheatstone Bridge Virtual Laboratory</h1>
      <p>DC bridge measurements · Measurements &amp; Instrumentation</p>
    </div>
  </div>
  <button class="icon" id="themeBtn" aria-label="Switch light or dark theme" title="Switch light or dark theme">◐ Theme</button>
</header>

<nav class="modes" role="tablist" aria-label="Experiment">
  <button class="mode" role="tab" data-mode="explore" aria-selected="true" title="Change every arm, watch the null">Explore the bridge<small>Change every arm, watch the null</small></button>
  <button class="mode" role="tab" data-mode="measure" aria-selected="false" title="Balance with a decade box">Measure an unknown resistor<small>Balance with a decade box</small></button>
  <button class="mode" role="tab" data-mode="strain" aria-selected="false" title="Quarter, half and full bridge">Strain-gauge bridge<small>Quarter, half and full bridge</small></button>
</nav>

<main>
<div class="layout">

  <aside class="card" aria-label="Controls">
    <h2>Bench controls</h2>
    <div class="muted">Settings apply to the circuit immediately.</div>

    <div class="sec">
      <h3>Supply</h3>
      <div class="ctl"><div class="ctlh">Supply voltage Vs<span class="inp"><input type="number" id="vsN" min="1" max="24" step="0.1" value="10"><em>V</em></span></div>
        <input type="range" id="vs" min="1" max="24" step="0.1" value="10" aria-label="Supply voltage"></div>
      <button class="btn keybtn" id="keyBtn"><span>Battery key K</span><span><span id="keyTxt">Closed</span> <span class="led on" id="keyLed"></span></span></button>
    </div>

    <div class="sec">
      <h3 id="armHead">Bridge arms</h3>
      <div id="armCtl"></div>
    </div>

    <div class="sec" id="galvCtl">
      <h3>Galvanometer</h3>
      <div class="ctl"><div class="ctlh">Coil resistance Rg<span class="inp"><input type="number" id="rgN" min="10" max="1000" step="1" value="100"><em>Ω</em></span></div>
        <input type="range" id="rg" min="10" max="1000" step="1" value="100" aria-label="Galvanometer resistance"></div>
      <div class="ctl"><div class="ctlh"><label for="rangeSel">Full-scale range</label>
        <select id="rangeSel"><option value="0.01">±10 mA</option><option value="0.001" selected>±1 mA</option><option value="0.0001">±100 µA</option><option value="0.00001">±10 µA</option></select></div>
        <div class="muted">Use a high range while far from balance; lower it for the final null.</div></div>
    </div>
    <div class="sec hidden" id="detNote"><h3>Detector</h3><div class="muted">A high-impedance amplifier (10 MΩ) reads the bridge output, so the bridge is practically unloaded.</div></div>

    <div class="sec"><button class="btn" id="resetBtn" style="width:100%">↺ Reset this experiment</button></div>
  </aside>

  <section class="stack">

    <div class="card">
      <h2 id="modeTitle"></h2>
      <div class="muted" id="modeDesc"></div>
      <div class="stage">
        <div class="panel"><svg id="diagram" viewBox="24 8 516 466" role="img" aria-label="Wheatstone bridge circuit diagram"></svg></div>
        <div>
          <div class="panel" id="dialWrap">
            <svg id="dial" viewBox="0 0 300 190" role="img" aria-label="Galvanometer dial"></svg>
