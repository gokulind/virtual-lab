  $('dRange').textContent='FS ±'+fmtI(S.range).replace('.00','')+' · 1 div = '+fmtI(per).replace(/\.0+ /,' ');
  $('dI').textContent=S.key?fmtI(sol.ig):'—';
  $('dDiv').textContent=S.key?(over?(div>0?'> +50 div':'< −50 div'):sgn(div,1)+' div'):'—';
  return div;
}

/* ---------- status, readouts, branch table ---------- */
function updStatus(R,sol,bal,div){
  var el=$('status'),cls,h;
  if(S.mode==='strain'){
    var mv=sol.vbc*1e3;
    if(!S.key){cls='idle';h='<b>Battery key open</b> — close K to energise the bridge.'}
    else if(Math.abs(S.eps)<0.5){cls='ok';h='<b>Balanced</b> — no strain, so Vo = 0.<span>Apply strain with the slider to unbalance the bridge.</span>'}
    else{cls='warn';h='<b>'+(S.eps>0?'Tension':'Compression')+'</b> — Vo = '+sgn(mv,3)+' mV ('+sgn(mv/S.vs,3)+' mV/V).<span>Output is proportional to strain; the bridge acts as a transducer.</span>'}
  }else if(!S.key){cls='idle';h='<b>Battery key open</b> — no current flows. Close key K to energise the bridge.'}
  else if(bal){cls='ok';h='<b>Balanced</b> — galvanometer reads zero.<span>R₁/R₂ = R₃/R₄ means B and C are at the same potential.</span>'}
  else if(Math.abs(div)>50){cls='warn';h='<b>Off-scale</b> — the galvanometer is overloaded.<span>Select a higher range, or move the adjustable arm toward balance.'+hintTxt(div)+'</span>'}
  else{cls='bad';h='<b>Unbalanced</b> — needle deflects '+(div>0?'right (+)':'left (−)')+' by '+Math.abs(div).toFixed(1)+' div.<span>'+(S.mode==='measure'?hintTxt(div).replace(/^ /,''):'Adjust an arm and watch the needle return toward zero.')+'</span>'}
  el.className='status '+cls;el.innerHTML=h;
}
function hintTxt(div){
  if(S.mode!=='measure'||!S.hint)return '';
  return ' Hint: R₃ is too '+(div>0?'high — decrease it.':'low — increase it.');
}
function card(l,v,sub){return '<div class="read"><small>'+l+'</small><b class="mono">'+v+'</b>'+(sub?'<i>'+sub+'</i>':'')+'</div>'}
function updReads(R,sol,bal){
  var h='';
  if(S.mode==='strain'){
    var x=S.gf*S.eps*1e-6,k={quarter:.25,half:.5,full:1}[S.cfg],ideal=S.vs*x*k*1e3,act=sol.vbc*1e3;
    var nl=Math.abs(ideal)>1e-9?(act-ideal)/ideal*100:0;
    h+=card('Output Vo',sgn(act,3)+' mV','open-circuit, B–C');
