/* ---------- galvanometer dial ---------- */
var needle={ang:0,vel:0,tgt:0,raf:0};
function buildDial(){
  var cx=150,cy=170,r=120;
  function pt(d,rad){var t=d*Math.PI/180;return [cx+rad*Math.sin(t),cy-rad*Math.cos(t)]}
  var p0=pt(-50,r),p1=pt(50,r),s='<rect class="face" x="6" y="6" width="288" height="178" rx="14"/>';
  s+='<path class="arc" d="M'+p0[0]+' '+p0[1]+' A'+r+' '+r+' 0 0 1 '+p1[0]+' '+p1[1]+'"/>';
  for(var d=-50;d<=50;d+=5){
    var maj=d%10===0,a=pt(d,r),b=pt(d,r-(maj?14:8));
    s+='<line class="'+(maj?'tmaj':'tmin')+'" x1="'+a[0]+'" y1="'+a[1]+'" x2="'+b[0]+'" y2="'+b[1]+'"/>';
    if(maj){var t=pt(d,r-26);s+='<text class="dl" x="'+t[0]+'" y="'+(t[1]+3)+'" text-anchor="middle">'+(d>0?'+'+d:d)+'</text>'}
  }
  s+='<text class="small" x="20" y="176">GALVANOMETER</text><text id="dRange" class="small" x="280" y="176" text-anchor="end"></text>';
  s+='<circle id="ovl" class="ovl" cx="270" cy="26" r="6"/><text class="small" x="258" y="30" text-anchor="end">OVERLOAD</text>';
  s+='<g id="needleG"><line class="needle" x1="150" y1="170" x2="150" y2="58"/></g><circle class="hub" cx="150" cy="170" r="9"/>';
  $('dial').innerHTML=s;
}
function stepNeedle(){
  var dt=1/60,k=85,c=10,acc=k*(needle.tgt-needle.ang)-c*needle.vel;
  needle.vel+=acc*dt;needle.ang+=needle.vel*dt;
  $('needleG').setAttribute('transform','rotate('+needle.ang.toFixed(3)+' 150 170)');
  if(Math.abs(needle.vel)>0.01||Math.abs(needle.tgt-needle.ang)>0.01){needle.raf=requestAnimationFrame(stepNeedle)}
  else{needle.raf=0;needle.ang=needle.tgt;$('needleG').setAttribute('transform','rotate('+needle.tgt+' 150 170)')}
}
function setNeedle(deg){
  needle.tgt=deg;
  if(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches){needle.ang=deg;$('needleG').setAttribute('transform','rotate('+deg+' 150 170)');return}
  if(!needle.raf)needle.raf=requestAnimationFrame(stepNeedle);
}
function updDial(sol){
  var div=S.key?sol.ig/S.range*50:0,over=Math.abs(div)>50;
  setNeedle(clamp(div,-54,54));
  $('ovl').setAttribute('class','ovl'+(over?' on':''));
